<Window x:Class="FleetDesktop.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fleet Desktop notification"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Width="525"
        Height="318"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!-- Borderless card with a DWM drop shadow: the 1px glass sliver at the bottom is
         what makes DWM keep drawing the shadow for a window with no visible frame. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Card" BorderThickness="1">
        <wv2:WebView2 x:Name="WebView" />
    </Border>
</Window>
